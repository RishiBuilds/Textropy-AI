{
  "manifest_version": 3,
  "name": "Textropy AI",
  "description": "Capture screenshots and extract text with Textropy AI OCR",
  "version": "1.0.0",
  "permissions": ["activeTab", "tabs", "storage"],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
